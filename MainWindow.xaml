<Window x:Class="TVisionUpperDemp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TVision · 平面坐标绘图实验室" Width="1280" Height="800" MinWidth="960" MinHeight="600" Background="#101722" Foreground="#E8EEF7" WindowStartupLocation="CenterScreen">
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="TVision 绘图实验室" FontSize="26" FontWeight="Bold"/><TextBlock Text="坐标系、图形标注与多渲染后端演示" Foreground="#91A4BE" Margin="0,3,0,14"/></StackPanel>
<Border Grid.Row="1" Background="#192436" CornerRadius="8" Padding="10" Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><TextBlock Text="渲染后端" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="RendererBox" Width="170" SelectedIndex="0"><ComboBoxItem>Canvas</ComboBoxItem><ComboBoxItem>FrameworkElement</ComboBoxItem><ComboBoxItem>DrawingVisual</ComboBoxItem><ComboBoxItem>SkiaSharp</ComboBoxItem><ComboBoxItem>WriteableBitmap</ComboBoxItem></ComboBox><TextBlock Text="  图形" VerticalAlignment="Center"/><ComboBox x:Name="ShapeBox" Width="150" SelectedIndex="0"><ComboBoxItem>文字</ComboBoxItem><ComboBoxItem>矩形</ComboBoxItem><ComboBoxItem>三角形</ComboBoxItem><ComboBoxItem>多边形</ComboBoxItem><ComboBoxItem>直线</ComboBoxItem><ComboBoxItem>直线箭头</ComboBoxItem><ComboBoxItem>圆弧</ComboBoxItem><ComboBoxItem>圆环</ComboBoxItem><ComboBoxItem>椭圆</ComboBoxItem></ComboBox><Button Content="添加到画布" Click="AddShape_Click"/><Button Content="清空" Click="Clear_Click"/><Button Content="重置视图" Click="Reset_Click"/><TextBlock x:Name="Hint" Text="  滚轮缩放 · 左键拖动平移 · 右键添加" Foreground="#91A4BE" VerticalAlignment="Center"/></StackPanel></Border>
<Border Grid.Row="2" Background="#0B111B" BorderBrush="#2B3B52" BorderThickness="1" CornerRadius="10"><Grid><ContentControl x:Name="Surface"/><TextBlock Text="坐标原点 (0, 0)" Foreground="#6F829B" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,10" IsHitTestVisible="False"/></Grid></Border>
<StatusBar Grid.Row="3" Background="Transparent" Foreground="#91A4BE"><StatusBarItem><TextBlock x:Name="Status" Text="就绪 · 视图比例 1.00"/></StatusBarItem></StatusBar>
</Grid></Window>
